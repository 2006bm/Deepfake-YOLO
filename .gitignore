# 数据 —— 体积巨大且可由脚本重建,绝不入库
data/raw/
# 用通配符覆盖所有版本的数据集:此前写死 dataset_v1,新增 dataset_v2 时
# 其 labels 被 git add -A 暂存(实测踩过),通配符可避免重复踩坑。
data/dataset_*/images/
data/dataset_*/labels/

# 训练输出与权重
runs/
weights/
*.pt
*.onnx
*.engine

# 媒体文件全局防护 —— 防止误提交数据集片段或图片。
# 注意:若将来要提交论文插图,需用 git add -f <file> 强制加入。
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# 下载器中间态与日志
*.part
filelist.json
logs_*.txt
logs_*.csv

# 归档包 —— dataset_v1.tar 有 3GB,且属于 FF++ 数据(见 LICENSE 说明),绝不入库
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# 评测输出(可由 evaluate/ 重新生成)
evaluate/*.csv
evaluate/*.png

# 调试产物
_debug/

# 未完成的探索性遗留目录
data/_spdtest/
data/scripts/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
